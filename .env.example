# agentsmemory configuration — copy to .env and fill in.
# Real environment variables always override values from .env.

# --- OAuth 2.1 (MCP, for the claude.ai remote connector) ---
# Issuer = the PUBLIC base URL of this server, no trailing slash, no /mcp.
# In production this must be the external https URL.
OAUTH_ISSUER=http://localhost:8080
# Stable secret that seals OAuth access/refresh tokens. Changing it invalidates
# every issued token. Generate one with:  openssl rand -hex 32
OAUTH_SECRET_KEY=

# --- Dashboard session cookie ---
# Signing key for the login session cookie, hex of >= 32 bytes.
# Generate with:  openssl rand -hex 32
AGENTSMEMORY_SESSION_KEY=

# --- API key reveal secret ---
# Seals workspace API keys at rest so the dashboard can reveal them after creation.
# Set it (32+ random chars) to keep keys revealable across restarts; unset uses a
# random per-boot key, so keys minted before a restart become reveal-unavailable.
# Generate with:  openssl rand -hex 32
AGENTSMEMORY_TOKEN_KEY=

# --- Social login (optional; goth) ---
# Only providers whose KEY/SECRET are set appear on the login page.
# PUBLIC_BASE_URL builds the OAuth callback URLs ({base}/auth/{provider}/callback).
PUBLIC_BASE_URL=http://localhost:8080
# GITHUB_KEY=
# GITHUB_SECRET=
# GOOGLE_KEY=
# GOOGLE_SECRET=
# FACEBOOK_KEY=
# FACEBOOK_SECRET=

# --- Platform superadmin (optional) ---
# Comma-separated emails allowed to edit the GLOBAL am_skillset wakeup playbook
# that every tenant shares (the only god-mode surface). Matched case-insensitively
# against the signed-in user's email. CLI flag --superadmin-emails overrides this.
# Empty (default) = no superadmin: the global skillset can still be seeded on a
# fresh database, just not edited from the dashboard.
# SUPERADMIN_EMAILS=you@example.com,colleague@example.com

# --- Analytics (optional) ---
# OpenPanel client id. Set it and every public and dashboard page renders the
# OpenPanel tracking snippet in its <head>; leave it unset (the default) and no
# tracker is emitted at all — which is what keeps a self-hosted install from
# reporting to a third party nobody chose.
#
# The client id ONLY. OpenPanel's browser SDK authenticates events with the id,
# while the account's client secret belongs to their server-side/export API — and
# anything rendered into a document head is public, so the secret must never be
# set here. If you later add server-side event ingest, read the secret in the
# server process and keep it out of the views package.
# OPENPANEL_CLIENT_ID=

# --- Billing (subscriptions: Pro monthly €50 / annual €500) ---
# Optional, and single-provider per deployment. Pick ONE backend with
# BILLING_PROVIDER; only that provider's keys need values. With the active
# provider's settings unset, billing is inert and the dashboard shows no
# upgrade button. The plan catalog (€50/mo, €500/yr, EUR) is seeded by migration —
# only the provider's price ids / checkout URLs (which differ test vs live) live here.
# BILLING_PROVIDER=stripe            # stripe (default) | opencollective

# Stripe (BILLING_PROVIDER=stripe): secret key + webhook signing secret, plus the
# Stripe Price id backing each plan. Webhook endpoint: {PUBLIC_BASE_URL}/webhooks/stripe.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_PRO_MONTHLY=
# STRIPE_PRICE_PRO_ANNUAL=

# OpenCollective (BILLING_PROVIDER=opencollective): donations platform — the Pro
# "checkout" is a hosted contribution page on the project's Open Collective, so no
# API credentials are needed, only the per-plan contribution-checkout URLs.
#   OPENCOLLECTIVE_CHECKOUT_PRO_MONTHLY  Contribution-checkout URL of the €50/month tier.
#   OPENCOLLECTIVE_CHECKOUT_PRO_ANNUAL   Contribution-checkout URL of the €500/year tier.
#   OPENCOLLECTIVE_PROJECT_URL           Project page — the manage/cancel surface
#                                        (OpenCollective has no customer-portal API).
# OpenCollective delivers webhooks to any URL but does NOT SIGN them, so one cannot
# be trusted to flip a paid plan. Instead the server ASKS: it polls OpenCollective's
# authenticated GraphQL API and reconciles contributions into plan changes (ADR-042).
#   OPENCOLLECTIVE_PERSONAL_TOKEN        Read-only personal token. THIS IS THE SWITCH:
#                                        unset it and reconciliation does not run at
#                                        all, leaving activation manual (see below).
#                                        Create one under your Open Collective
#                                        account, "For developers" → Personal Token.
#   OPENCOLLECTIVE_COLLECTIVE_SLUG       Whose orders to read, e.g. ai-agents-memory.
#   OPENCOLLECTIVE_API_URL               GraphQL endpoint. Defaults to the public one;
#                                        override only for staging or a test double.
#   OPENCOLLECTIVE_RECONCILE_INTERVAL    Poll period, default 15m. One pass costs a
#                                        few requests against a 100/min limit.
# With the token unset — or for a contribution made outside our upgrade button, which
# carries no attribution and is deliberately left alone rather than guessed at — an
# operator activates the plan by hand:
#   agentsmemory set-plan --slug <workspace> --plan pro_monthly
# OPENCOLLECTIVE_CHECKOUT_PRO_MONTHLY=https://opencollective.com/it-uoga/projects/ai-agents-memory/contribute/pro-monthly-104934/checkout
# OPENCOLLECTIVE_CHECKOUT_PRO_ANNUAL=https://opencollective.com/it-uoga/projects/ai-agents-memory/contribute/pro-yearly-104935/checkout
# OPENCOLLECTIVE_PROJECT_URL=https://opencollective.com/it-uoga/projects/ai-agents-memory
# OPENCOLLECTIVE_PERSONAL_TOKEN=oc_pat_replace_me
# OPENCOLLECTIVE_COLLECTIVE_SLUG=ai-agents-memory
# OPENCOLLECTIVE_API_URL=https://api.opencollective.com/graphql/v2
# OPENCOLLECTIVE_RECONCILE_INTERVAL=15m

# --- Server ---
# HTTP listen address and SQLite database path. CLI flags --addr / --db override
# these; both fall back to the built-in defaults when unset.
AGENTSMEMORY_ADDR=:8080
AGENTSMEMORY_DB=agentsmemory.db
# Verbose logging: per-request HTTP access logs (chi) + gorm SQL. Off by default
# (the server is intentionally quiet); set true to see traffic during dev.
# Overridable with --debug.
APP_DEBUG=false

# --- Read-only `mcp` CLI (optional) ---
# An API key for the `agentsmemory mcp` subcommand so a local read resolves a
# tenant and meters like the HTTP path. Only the CLI reads it; the server does
# not. CLI flag --token overrides this. Leave unset unless you use that CLI.
# AGENTSMEMORY_TOKEN=

# --- Vector storage (SQLite source of truth + a search index over it) --------
# SQLite always stores every vector durably (the source of truth). VECTOR_BACKEND
# picks what answers search, and switching only costs an index rebuild:
#   sqlite  — the SQLite store also serves search (brute force, no external
#             service); the easy default for local dev.
#   chromem — an embedded vector DB inside this process: vectors in memory,
#             persisted next to the database (agentsmemory.db ->
#             agentsmemory.chromem/). No service to run; --local picks it by
#             default. Delete that directory to force a rebuild from SQLite.
#   qdrant  — SQLite stays the source of truth and Qdrant is the search index.
VECTOR_BACKEND=sqlite
# Qdrant connection (only used when VECTOR_BACKEND=qdrant).
QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=

# --- Embeddings (Ollama) ---
# Ollama server that turns drawer text into vectors. bge-m3 is 1024-dimensional.
OLLAMA_URL=http://localhost:11434
OLLAMA_EMBED_MODEL=bge-m3

# --- `agentsmemory eval` question generator ---
# Only used by the eval command; the running server never calls this.
#
# eval writes its own questions: for each sampled drawer a model is asked what
# question that drawer answers, which is what makes labelling free. That model
# must be GENERATIVE — bge-m3 and nomic-embed-text are embedders and cannot
# answer /api/generate, so a palace whose Ollama holds only embedders fails every
# case with `model '...' not found` until one is pulled (`ollama pull
# qwen2.5-coder:7b`).
# EVAL_GEN_MODEL=qwen2.5-coder:7b
#
# Where to generate. Defaults to OLLAMA_URL, so a single-machine setup sets
# nothing. Set it to send this one-off burst of LLM work to a bigger or hosted
# model while your vectors stay on the local box — the embedder is unaffected.
# The wire format is Ollama's own /api/generate, so this accepts another Ollama
# (local, remote, or hosted), NOT an OpenAI-shaped /v1/chat/completions endpoint.
# EVAL_GEN_URL=https://ollama.com
# EVAL_GEN_API_KEY=

# --- Ranking knobs -----------------------------------------------------------
# Evidence sent to the cross-encoder. lexical is the zero-latency control;
# semantic embeds overlapping windows from each reassembled long memory and
# selects several distant matches before one cross-encoder call. It is inert
# unless RERANK_URL is set. Restart, then confirm `am_status.ranking` reports
# evidence=lexical or evidence=semantic. Ranking is always per logical memory.
MEMORY_EVIDENCE_SELECTOR=lexical
#
# How a raw cross-encoder score is scaled before RERANK_WEIGHT blends it with the
# fused score.
#   sigmoid  (default) 1/(1+e^-x) on the logit, fused scaled by the pool max.
#            Preserves CONFIDENCE: an indifferent cross-encoder lands flat near
#            0.5 and the lexical evidence decides.
#   minmax   the original. SCALE-FREE on both axes, so a 0.001 logit spread and a
#            10.0 one both span the full range — and on a small pool at weight
#            0.5 an opposed pair TIES and the cross-encoder is discarded outright.
#   rank     position only. No amplification, no confidence, still ties.
# Confirm with `am_status.ranking`, which reports norm=<value>.
RERANK_NORM=sigmoid
#
# Lexical fusion weight: 'auto' (default) scales BM25 per query by how much
# lexical signal the query carries against the candidates; a fixed 0..1 pins it.
# BM25_WEIGHT=auto
#
# 'auto-idf' is 'auto' with each query term weighted by how much it
# discriminates, instead of counted once. The binary count reads a term
# appearing in nearly every candidate as lexical signal — which is exactly when
# BM25 is noise — and auto-idf is ahead on every table measured so far (four,
# across two unrelated corpora). It is not the default only because a ranking
# default changes what every existing palace returns.
# BM25_WEIGHT=auto-idf
#
# Closet curation prior, 0..1. Closets summarise mined sources, and their boost
# promotes drawers from sources a search's closet hits point at. On a curated
# palace that prior helps; on a corpus dominated by raw mined transcripts the
# eval measured the same boost DEMOTING correct answers (~0.10 MRR) — the
# closets cover the curated slice and lift it over the mined gold. Set 0 to
# turn the prior (and its per-search closet lookup) off. 0 is the DEFAULT since
# 2026-08-21; set 1 to restore the full curation prior.
# CLOSET_BOOST=0
#
# Floor on how many distinct memories Search retrieves before ranking,
# independent of the page --limit. 0 (the default) uses the formula: limit×3,
# raised to RERANK_POOL when a cross-encoder will actually run. A positive
# value widens; it never shrinks below that formula and never changes the
# page size. The eval's `production (Search) retrieve-k=50` arm measures this
# floor at the default page of 5.
# RETRIEVE_K=0
#
# How vector and lexical evidence combine: 'rrf' (DEFAULT since 2026-08-21 —
# reciprocal-rank fusion) or 'linear' (blends the two scores, weighted by
# BM25_WEIGHT). Under rrf, BM25_WEIGHT and LEX_NORM are both inert. A linear blend lets one bad
# signal drag a good candidate down; on a large diverse palace BM25 measured
# BELOW vector alone, and since the cross-encoder's pool is taken off the fused
# head, the reranker never saw what fusion had buried. RRF was the best arm
# there. Run `agentsmemory eval` on your own corpus before switching — the rrf
# arm in its table is exactly this question.
# FUSION=rrf
#
# How raw lexical scores are normalised before they are fused: 'page-max'
# (default), 'ceiling' or 'saturating'. page-max scales the page so its best
# lexical match reads 1.0, which means the lexical channel always speaks at full
# volume even when nothing in the page is a good lexical match. The anchored
# transforms measure each candidate against the score the QUERY could have
# attained instead, so a page with no good lexical hit lets the vector channel
# decide. DOES NOTHING when FUSION=rrf: rank fusion combines positions, not
# magnitudes, so there is no lexical magnitude to normalise. The eval's anchored
# arms measure exactly this choice — run it on your own corpus before changing.
# LEX_NORM=page-max


# --- Embeddings ---------------------------------------------------------------
# What turns text into vectors: 'ollama' (default) or 'tei'.
#
# Ollama's embedding API returns DENSE vectors only. bge-m3 natively produces
# three representations — dense, learned sparse, and a ColBERT-style
# multi-vector — and two of them are unreachable through Ollama, so a whole
# class of retrieval work cannot even be measured while it is the only backend.
# TEI is also what already serves the cross-encoder, so choosing it removes a
# service rather than adding one.
# EMBED_BACKEND=tei
# EMBED_URL=http://localhost:8081

# --- Recall scope ---------------------------------------------------------------
# How wide a recall reaches when the caller names no wing: 'wing' (default) or
# 'workspace'.
#
# This is the one setting on this branch that CHANGES existing behaviour, so it
# is the one most worth knowing about. Recall used to search every wing; it now
# defaults to the wing the MCP registration was created for, because one
# project's memories answering another's question is not a smaller problem than
# missing an answer — an agent acting on a decision nobody made about the code in
# front of it is worse than an agent that finds nothing. A larger, more
# heterogeneous corpus also measurably retrieves WORSE: unrelated projects do not
# remove the answer, they add competitors ahead of it.
#
# Callers can still reach across deliberately: pass wing:"*" to search every
# wing, or name another wing directly. Set this to 'workspace' to restore the old
# default globally.
# SEARCH_SCOPE=workspace

# --- Stdio bridge ---------------------------------------------------------------
# Where `agentsmemory stdio` connects when it is not using a unix socket. The
# bridge is what lets an agent that speaks stdio MCP talk to an HTTP server, so
# this is the knob for pointing one at a server that is not on localhost:8080.
# AGENTSMEMORY_URL=http://localhost:8080/mcp

# --- Client transport ------------------------------------------------------------
# How the CLI and the stdio bridge reach a server. Three knobs, each documented
# here because the gate that checks "read but documented nowhere" found them and
# an operator with a non-default setup needs all three.
#
# Run against a server on this machine rather than the hosted service. This is the
# default for the kit installer, and it is the setting that keeps private
# transcripts local: `mine-claude` uploads what it reads, so the hosted service
# has to be asked for by name.
# AGENTSMEMORY_LOCAL=1
#
# The MCP endpoint the client calls. Point it at another host to use a server that
# is not on localhost.
# AGENTSMEMORY_MCP_URL=http://localhost:8080/mcp
#
# A unix socket instead of TCP. Preferred on a single machine: no port to expose
# and the socket's file permissions are the access control.
# AGENTSMEMORY_SOCKET=/tmp/agentsmemory.sock

# Budget for outbound calls to the vector store and the embedder. Raise it for a
# slow or cold embedder, which is the case an operator hits first.
HTTP_TIMEOUT=30s

# Budget for ONE embed call, separate from HTTP_TIMEOUT because embedding is
# inference: a batch of 64 drawer-sized chunks on a CPU-only host was measured at
# 121 seconds (2026-08-31, bge-m3 on 16GB, no GPU), four times the interactive
# default — which aborted a `mine-claude` seeding run on its first session. Sized
# for the worst batch in a run, not the median.
EMBED_TIMEOUT=5m

# OpenTelemetry. Empty (unset) leaves tracing off. stdout prints a compact
# stage tree to stderr (file:line, outcome, reason) so you can check a stage
# is wired and actually exercised. Any other value is an OTLP HTTP collector
# URL. Does not change search results. A collector that is down drops
# observability, not recall.
# AGENTSMEMORY_OTEL_ENDPOINT=stdout

# Monthly metered-request cap, for EVERY workspace this process serves.
# Unset (or 0) leaves each workspace's plan deciding, which is what a hosted
# deployment wants. A positive number caps every workspace there. A NEGATIVE
# number uncaps them, matching the -1 the Unlimited plan row carries.
#
# Set it on a self-hosted install: the cap is enforced whether or not billing is
# configured, so a workspace on the seeded Free plan stops answering its own
# owner after 10000 requests a month — a limit that exists to price a hosted
# service. This is deployment policy and edits no plan row, so unsetting it
# restores plan-derived caps with nothing to undo.
# AGENTSMEMORY_MONTHLY_REQUEST_CAP=-1
