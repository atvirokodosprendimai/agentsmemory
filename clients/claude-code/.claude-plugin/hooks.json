{
  "hooks": {
    "SessionStart": [
      { "hooks": [
        { "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/hooks/agentsmemory-verify-hook.sh" },
        { "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/hooks/agentsmemory-recall-hook.sh" }
      ] }
    ],
    "UserPromptSubmit": [
      { "hooks": [ { "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/hooks/agentsmemory-task-recall-hook.sh" } ] }
    ],
    "UserPromptExpansion": [
      { "hooks": [ { "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/hooks/agentsmemory-task-recall-hook.sh" } ] }
    ],
    "PreToolUse": [
      { "hooks": [ { "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/hooks/agentsmemory-anchor-cue-hook.sh" } ] }
    ],
    "PostToolUse": [
      { "hooks": [ { "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/hooks/agentsmemory-touched-hook.sh" } ] }
    ],
    "SubagentStart": [
      { "hooks": [ { "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/hooks/agentsmemory-subagent-start-hook.sh" } ] }
    ],
    "SubagentStop": [
      { "hooks": [ { "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/hooks/agentsmemory-stop-hook.sh" } ] }
    ],
    "Stop": [
      { "hooks": [ { "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/hooks/agentsmemory-stop-hook.sh" } ] }
    ],
    "SessionEnd": [
      { "hooks": [ { "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/hooks/agentsmemory-session-end-hook.sh" } ] }
    ]
  }
}
